# Django Settings
DEBUG=1

# SECRET_KEY: Must be a unique cryptographically secure key in production.
# The server will raise ImproperlyConfigured and fail to start if DEBUG=0 and this is missing or default.
SECRET_KEY=generate_your_secret_key_here

DATABASE_URL=postgres://postgres:postgres@db:5432/eventmate
REDIS_URL=redis://redis:6379/0

# ALLOWED_HOSTS: Must list your backend domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Throttling limits (Django Rest Framework)
DRF_THROTTLE_ANON=100/day
DRF_THROTTLE_USER=1000/day

# CORS & CSRF Settings:
# WARNING: NEVER use wildcard "*" in production for CORS/CSRF.
# CORS_ALLOWED_ORIGINS must match the exact frontend URL (with protocol).
# CSRF_TRUSTED_ORIGINS must include the exact frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# AI Integration Settings (Optional)
# Provider type: "generic_openai_compatible" works with OpenAI, OpenRouter, DeepSeek, Ollama, vLLM, etc.
# If AI_API_KEY is not set, the backend operates in deterministic fallback mode
# returning template-based text suitable for diploma evaluation out-of-the-box.
AI_PROVIDER=generic_openai_compatible
AI_API_KEY=
AI_API_URL=
AI_API_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=15
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=500
AI_TEMPERATURE=0.7

# Payment Provider Settings
# Note: Real payment provider config (like keys/secrets) belongs ONLY in local backend .env or server environment.
# Mock mode is enabled by default in local/debug environments.
# To switch to CloudPayments, set PAYMENT_PROVIDER=cloudpayments, and fill in Public ID (Public Key) & API Secret (Secret Key).
# Ensure KZT currency capability is explicitly enabled/verified for your merchant account in the CloudPayments dashboard.
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=True
PAYMENT_API_URL=https://api.cloudpayments.kz
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:3000/dashboard/orders/{order_id}/
PAYMENT_CANCEL_URL=http://localhost:3000/dashboard/orders/{order_id}/

# Billing Provider Settings
BILLING_PAYMENT_PROVIDER=mock
BILLING_RETURN_URL=http://localhost:3000/{locale}/provider/billing
BILLING_CANCEL_URL=http://localhost:3000/{locale}/provider/billing
BILLING_CHECKOUT_INITIALIZATION_TIMEOUT_SECONDS=60
BILLING_PAYMENT_TIMEOUT_SECONDS=15
BILLING_PENDING_CHECKOUT_MINUTES=30

# Webhook authentication: HMAC-SHA256 shared secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real value. Never expose via NEXT_PUBLIC.
# No frontend access to this secret.
BILLING_PAYMENT_WEBHOOK_SECRET=

# Stale webhook processing event reclaim timeout (seconds)
BILLING_WEBHOOK_PROCESSING_TIMEOUT_SECONDS=120


# 2GIS private geocoding configuration
# DGIS_API_KEY belongs only in ignored backend/.env or deployment environment.
# Never expose it through public NEXT_PUBLIC variables.
DGIS_API_KEY=
DGIS_API_URL=https://catalog.api.2gis.com/3.0/items/geocode
DGIS_GEOCODING_ENABLED=False
DGIS_TIMEOUT_SECONDS=10
DGIS_GEOCODING_CACHE_SECONDS=86400
DGIS_GEOCODING_MAX_QUERY_LENGTH=200
DGIS_GEOCODING_RESULT_LIMIT=5

# Media Storage Configuration
MEDIA_STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True
AWS_S3_ADDRESSING_STYLE=
AWS_S3_SIGNATURE_VERSION=s3v4

# Media Validation and Limit Settings
MEDIA_MAX_IMAGE_SIZE_MB=5
MEDIA_MAX_SOURCE_IMAGE_PIXELS=50000000
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MEDIA_MAX_IMAGE_WIDTH=4096
MEDIA_MAX_IMAGE_HEIGHT=4096
MEDIA_IMAGE_JPEG_QUALITY=85
MEDIA_IMAGE_WEBP_QUALITY=85
MEDIA_UPLOAD_THROTTLE_RATE=10/min

# PayPal Settings
PAYPAL_MODE=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_SANDBOX_CONVERSION_ENABLED=True
PAYPAL_SANDBOX_KZT_PER_USD=450.00
PAYPAL_SANDBOX_CURRENCY=USD

# PayPal Billing API credentials (isolated from orders)
PAYPAL_BILLING_CLIENT_ID=
PAYPAL_BILLING_CLIENT_SECRET=
PAYPAL_BILLING_WEBHOOK_ID=

# PayPal Orders API credentials (isolated from billing)
PAYPAL_ORDERS_CLIENT_ID=
PAYPAL_ORDERS_CLIENT_SECRET=
PAYPAL_ORDERS_WEBHOOK_ID=

# Backend Base API URL (used for webhooks and redirection)
BACKEND_API_BASE_URL=http://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000
